code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_toon, specular_toon;


// Varyings
varying vec3 var_WorldPos;

uniform sampler2D Texture2DParameter;
uniform float Dissolve_Height = 0.25;
uniform float Noise_scale = 0.5;
uniform vec2 Speed = vec2(0.013000, 0.030000);
uniform float Frequency = 1.0;
uniform sampler2D Noise : repeat_enable;
uniform vec2 Speed2 = vec2(-0.005000, 0.010000);
uniform float CutOff = 0.5;



void vertex() {
// Input:3
	mat4 n_out3p0 = MODEL_MATRIX;


// Input:4
	vec3 n_out4p0 = VERTEX;


// TransformVectorMult:5
	vec3 n_out5p0 = (n_out3p0 * vec4(n_out4p0, 1.0)).xyz;


// VaryingSetter:2
	var_WorldPos = n_out5p0;


}

void fragment() {
// Input:61
	bool n_out61p0 = FRONT_FACING;


	vec4 n_out67p0;
// Texture2D:67
	n_out67p0 = texture(Texture2DParameter, UV);


// Input:38
	vec4 n_out38p0 = COLOR;


// VectorOp:68
	vec4 n_out68p0 = n_out67p0 * n_out38p0;


// ColorConstant:63
	vec4 n_out63p0 = vec4(0.000000, 0.000000, 0.000000, 1.000000);


	vec3 n_out62p0;
// Switch:62
	n_out62p0 = mix(vec3(n_out63p0.xyz), vec3(n_out68p0.xyz), float(n_out61p0));


	vec3 n_out69p0;
// ColorFunc:69
	{
		vec3 c = n_out62p0;
		n_out69p0 = mix(pow((c.rgb + vec3(0.055)) * (1.0 / (1.0 + 0.055)), vec3(2.4)), c.rgb * (1.0 / 12.92), lessThan(c.rgb, vec3(0.04045)));
	}


// FloatParameter:52
	float n_out52p0 = Dissolve_Height;


// FloatParameter:54
	float n_out54p0 = Noise_scale;


// Vector2Parameter:9
	vec2 n_out9p0 = Speed;


// Input:3
	float n_out3p0 = TIME;


// FloatOp:70
	float n_in70p1 = 0.10000;
	float n_out70p0 = n_out3p0 * n_in70p1;


// VectorOp:13
	vec2 n_out13p0 = n_out9p0 * vec2(n_out70p0);


// VaryingGetter:60
	vec3 n_out60p0 = var_WorldPos;


// VectorOp:71
	vec2 n_in71p1 = vec2(1.00000, 1.00000);
	vec2 n_out71p0 = vec2(n_out60p0.xy) * n_in71p1;


// VectorOp:12
	vec2 n_out12p0 = n_out13p0 + n_out71p0;


// FloatParameter:27
	float n_out27p0 = Frequency;


// VectorOp:26
	vec2 n_out26p0 = n_out12p0 * vec2(n_out27p0);


	vec4 n_out59p0;
// Texture2D:59
	n_out59p0 = texture(Noise, n_out26p0);


// Vector2Parameter:35
	vec2 n_out35p0 = Speed2;


// VectorOp:37
	vec2 n_out37p0 = n_out35p0 * vec2(n_out70p0);


// VectorOp:32
	vec2 n_out32p0 = n_out71p0 + n_out37p0;


// VectorOp:33
	vec2 n_out33p0 = vec2(n_out27p0) * n_out32p0;


	vec4 n_out28p0;
// Texture2D:28
	n_out28p0 = texture(Noise, n_out33p0);


// FloatConstant:30
	float n_out30p0 = 0.500000;


// Mix:29
	vec4 n_out29p0 = mix(n_out59p0, n_out28p0, vec4(n_out30p0));


// FloatOp:56
	float n_out56p0 = n_out54p0 * n_out29p0.x;


// FloatOp:55
	float n_in55p1 = 0.50000;
	float n_out55p0 = n_out54p0 * n_in55p1;


// FloatOp:57
	float n_out57p0 = n_out56p0 - n_out55p0;


// VaryingGetter:49
	vec3 n_out49p0 = var_WorldPos;


// VectorDecompose:50
	float n_out50p0 = n_out49p0.x;
	float n_out50p1 = n_out49p0.y;
	float n_out50p2 = n_out49p0.z;


// FloatOp:58
	float n_out58p0 = n_out57p0 + n_out50p1;


// Step:51
	float n_out51p0 = step(n_out52p0, n_out58p0);


// FloatFunc:53
	float n_out53p0 = 1.0 - n_out51p0;


// Input:64
	bool n_out64p0 = FRONT_FACING;


	float n_out65p0;
// Switch:65
	float n_in65p1 = 0.00000;
	float n_in65p2 = 0.00000;
	n_out65p0 = mix(n_in65p2, n_in65p1, float(n_out64p0));


// FloatParameter:48
	float n_out48p0 = CutOff;


// Output:0
	ALBEDO = n_out69p0;
	ALPHA = n_out53p0;
	SPECULAR = n_out65p0;
	ALPHA_SCISSOR_THRESHOLD = n_out48p0;


}
